{
  "model": "sonnet",
  "permissions": {
    "deny": [
      "Read(.env)", "Read(**/.env)", "Read(**/.env.local)",
      "Read(~/.ssh/**)", "Read(~/.aws/**)",
      "Bash(ssh:*)", "Bash(scp:*)", "Bash(curl:*)", "Bash(wget:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node .claude/hooks/critical-rules.cjs" }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "node .claude/hooks/guard-push-deploy.cjs" },
        { "type": "command", "command": "node .claude/hooks/secret-scan.cjs" }
      ] },
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "node .claude/hooks/guard-write.cjs" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "node .claude/hooks/post-edit-notes.cjs" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node .claude/hooks/build-gate.cjs", "timeout": 120 }] }
    ]
  }
}
